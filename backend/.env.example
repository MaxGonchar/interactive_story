# ---------------------------------------------------------------
# Backend environment configuration
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to version control.
# ---------------------------------------------------------------

# Logging verbosity.
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to make cross-origin requests.
# Used by the CORS middleware in main.py (ALLOWED_ORIGINS).
# Example for local development: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Path to the YAML data directory, relative to the backend/ directory.
# Contains story, scene, and character YAML files.
DATA_DIR=../data

# LLM / Venice AI
# Required API key for play requests that invoke the Venice AI adapter.
VENICE_API_KEY=

# Optional model override. Defaults to llama-3.3-70b when unset.
VENICE_MODEL=
