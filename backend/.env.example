# ---------------------------------------------------------------
# Backend environment configuration
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to version control.
# ---------------------------------------------------------------

# Logging verbosity.
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to make cross-origin requests.
# Used by the CORS middleware in main.py (ALLOWED_ORIGINS).
# Example for local development: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Path to the YAML data directory, relative to the backend/ directory.
# Contains story, scene, and character YAML files.
DATA_ROOT=../data

# LLM / Venice AI
# Required API key for play requests that invoke the Venice AI adapter.
VENICE_API_KEY=

# Optional model override. Defaults to llama-3.3-70b when unset.
VENICE_MODEL=

# Optional HTTP timeout for Venice requests in seconds.
# Must be a positive number. Defaults to 300.
VENICE_TIMEOUT_SECONDS=300

# LLM prompt/response logging controls.
# LLM_LOG_LEVEL accepts: DEBUG, INFO, WARNING, ERROR
# LLM_LOG_PROMPT and LLM_LOG_RESPONSE accept: 1/0, true/false, yes/no, on/off
LLM_LOG_LEVEL=INFO
LLM_LOG_PROMPT=false
LLM_LOG_RESPONSE=false

SUMMARY_MODEL=
